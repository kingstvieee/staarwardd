OPENAI_API_KEY=
OPENAI_MODEL=
PORT=3000
# Local prototype owner gate; use a secret outside source control.
STAARWAARDD_OWNER_TOKEN=
# Optional durable audit path; defaults to data/guardian-audit.jsonl.
STAARWAARDD_AUDIT_PATH=
# M5 production-trust secrets. Use strong random values outside source control.
STAARWAARDD_CONNECTOR_ATTESTATION_SECRET=
STAARWAARDD_MEMORY_ENCRYPTION_SECRET=
# Optional local trust-store paths.
STAARWAARDD_IDENTITY_STORE=.guardian/identities.json
STAARWAARDD_ENCRYPTED_MEMORY_STORE=.guardian/memory.enc.json
